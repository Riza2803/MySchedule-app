{
  "expo": {
    "name": "MySchedule",
    "slug": "myschedule",
    "scheme": "myschedule",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F8F2E6"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.riza.myschedule"
    },
    "android": {
      "package": "com.riza.myschedule",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F8F2E6"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "ScheduleWidget",
              "label": "MySchedule Agenda",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "maxResizeWidth": "500dp",
              "maxResizeHeight": "400dp",
              "resizeMode": "horizontal|vertical",
              "description": "Menampilkan agenda dan tugas aktif hari ini beserta jam mulai dan tombol status",
              "previewImage": "./assets/widget-preview.png",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "f9bce4a1-58b1-4fa5-84ad-6e3d2603db4c"
      }
    },
    "owner": "riza2803"
  }
}
