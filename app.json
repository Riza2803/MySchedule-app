{
  "expo": {
    "name": "MySchedule",
    "slug": "myschedule",
    "scheme": "myschedule",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.riza.myschedule"
    },
    "android": {
      "package": "com.riza.myschedule",
      "adaptiveIcon": {
        "backgroundColor": "#1F241E"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "ScheduleWidget",
              "label": "MySchedule Agenda",
              "minWidth": "160dp",
              "minHeight": "80dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "description": "Menampilkan agenda dan tugas aktif hari ini beserta jam mulai dan tombol status",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "f9bce4a1-58b1-4fa5-84ad-6e3d2603db4c"
      }
    },
    "owner": "riza2803"
  }
}
